{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPTZ environment contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["variables"],
  "properties": {
    "$schema": { "type": "string" },
    "doppler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string", "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$" },
        "config": { "oneOf": [ { "type": "string", "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$" }, { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$" } } ] },
        "fallback": { "type": "boolean", "description": "Encrypted Doppler fallback; defaults to true in development and false in production." },
        "watch": { "type": "boolean", "default": false, "description": "Opt-in upstream beta: restart development when secrets rotate." },
        "preserve": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }, "uniqueItems": true }
      }
    },
    "variables": {
      "type": "object",
      "propertyNames": { "pattern": "^(?!DOPPLER_|__OPTZ_DOPPLER_ACTIVE$)[A-Z_][A-Z0-9_]*$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "type": { "enum": ["string", "url", "number", "boolean", "json"], "default": "string" },
          "optional": { "type": "boolean", "default": false },
          "default": { "type": "string", "description": "Defaults are committed configuration; never put a secret here." },
          "values": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "public": { "type": "boolean", "default": false, "description": "Only an explicit PUBLIC_* name may enter generated browser JSON." }
        }
      }
    }
  }
}
