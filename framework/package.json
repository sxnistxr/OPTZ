    "./hydrate": "./src/hydrate.tsx",
    "./islands": "./src/islands.ts",
    "./action-client": "./src/action-client.ts",
    "./edge": "./src/edge.ts",
    "./seo": "./src/seo.ts",
    "./mcp": "./src/mcp.ts",
    "./dialog": "./src/dialog.tsx",
    "./cdn": "./src/cdn.ts",
    "./test": "./src/testing.ts",
    "./sessions": "./src/sessions.ts",
    "./forms": "./src/forms.ts",
    "./security": "./src/security.ts",
    "./sqlite": "./src/sqlite.ts",
    "./stream": "./src/stream.ts",
    "./storage": "./src/storage.ts",
    "./observe": "./src/observe.ts",
    "./env": "./src/env.ts",
    "./env.schema.json": "./schema/env.schema.json"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
