{
  "name": "@sxnistxr/optz",
  "version": "0.4.0",
  "description": "A small, fast React framework for Bun: file routes, layouts, loaders, middleware, static-first rendering.",
  "type": "module",
  "keywords": [
    "react",
    "bun",
    "framework",
    "islands",
    "ssr",
    "static-site",
    "mcp"
  ],
  "homepage": "https://dihlabs.lol/docs/framework",
