# Production unit for the OPTZ server (outside the challenge submission).
# Installed by ops/install-prod.sh. Config lives in /etc/optz/env (SQLITE_PATH, JWT_SECRET,
# HOST, PORT) so the binary stays configured by those four variables only.
[Unit]
Description=OPTZ feed API (Rust + io_uring + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=optz
Group=optz
EnvironmentFile=/etc/optz/env
ExecStart=/opt/optz/current/bin/twelve-iouring
# Crashes restart; a clean SIGTERM shutdown (drain + WAL checkpoint) doesn't trigger a restart.
Restart=on-failure
RestartSec=1
# The server drains for at most 5 s and then checkpoints; give it room.
TimeoutStopSec=30
KillSignal=SIGTERM

LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Memory: the server's own admission control refuses connections before this; these keep a
# runaway from taking the whole box (sshd, journald) down with it.
MemoryHigh=1700M
MemoryMax=1800M
OOMScoreAdjust=-500

# Hardening.
ProtectSystem=strict
ReadWritePaths=/var/lib/optz
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
# @system-service plus io_uring, which that set doesn't include.
SystemCallFilter=@system-service io_uring_setup io_uring_enter io_uring_register
UMask=0077

[Install]
WantedBy=multi-user.target
