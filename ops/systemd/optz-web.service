# The site (portfolio/, dihlabs.lol), served by the optz framework on Bun. nginx proxies pages
# and /api here; /assets come from disk. The framework is at ../framework (web/framework). Installed by ops/install-prod.sh.
[Unit]
Description=OPTZ site (optz on Bun)
After=network-online.target optz.service
Wants=network-online.target

[Service]
Type=simple
User=optz
Group=optz
WorkingDirectory=/opt/optz/current/web/portfolio
Environment=PORT=3001 HOST=127.0.0.1 NODE_ENV=production
# The image optimizer's disk cache: the one writable place under ProtectSystem=strict (systemd
# creates /var/cache/optz-web/images, owned by the service user).
CacheDirectory=optz-web/images
Environment=OPTZ_IMAGE_CACHE_DIR=/var/cache/optz-web/images
ExecStart=/opt/bun/bin/bun ../framework/src/cli.ts start
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

# Measured: ~33 MiB idle, ~44 MiB peak under load. Cap it well above that so a leak can't eat
# the memory the API's connections need.
MemoryHigh=160M
MemoryMax=200M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No MemoryDenyWriteExecute: Bun's JIT needs writable+executable memory.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
