PUBLIC_URL=http://localhost:3008
# Generate AUTH_SECRET with: bun -e 'console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64({alphabet:"base64url",omitPadding:true}))'
AUTH_SECRET=
AUTH_DATABASE_PATH=.data/auth.sqlite
AUTH_ALLOW_SIGNUP=true
# Email (or supply your own adapter in app/lib/auth.server.ts)
RESEND_API_KEY=
EMAIL_FROM=
# SMS is disabled unless configured. Set a provider spending cap as well.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
SMS_ALLOWED_PREFIXES=+1555
# Register http://localhost:3008/api/auth/callback/PROVIDER with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Also supported: MICROSOFT, APPLE, DISCORD, FACEBOOK, TWITTER, LINKEDIN, GITLAB, TWITCH, SPOTIFY, SLACK.

# Optional modules: no account is an administrator until its verified ID is selected.
MODULES_ADMIN_USER_ID=
MODULES_DATABASE_PATH=.data/modules.sqlite
ANALYTICS_HASH_SECRET=
# Private S3/R2/B2; endpoints must be HTTPS. Credentials may instead come from an IAM role.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_SHA256=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
