{
  "$schema": "../../framework/schema/env.schema.json",
  "doppler": {
    "project": "optz-auth",
    "config": {
      "development": "dev",
      "production": "prd",
      "test": "dev"
    },
    "watch": false
  },
  "variables": {
    "PUBLIC_URL": {
      "type": "url",
      "default": "http://localhost:3008",
      "public": true
    },
    "AUTH_SECRET": {
      "type": "string"
    },
    "AUTH_DATABASE_PATH": {
      "default": ".data/auth.sqlite"
    },
    "AUTH_ALLOW_SIGNUP": {
      "type": "boolean",
      "default": "false"
    },
    "MODULES_ADMIN_USER_ID": {
      "optional": true
    },
    "MODULES_DATABASE_PATH": {
      "default": ".data/modules.sqlite"
    },
    "ANALYTICS_HASH_SECRET": {
      "optional": true
    },
    "S3_BUCKET": {
      "optional": true
    },
    "S3_ENDPOINT": {
      "type": "url",
      "optional": true
    },
    "S3_REGION": {
      "default": "us-east-1"
    },
    "S3_SHA256": {
      "type": "boolean",
      "default": "true"
    },
    "AWS_ACCESS_KEY_ID": {
      "optional": true
    },
    "AWS_SECRET_ACCESS_KEY": {
      "optional": true
    }
  }
}
